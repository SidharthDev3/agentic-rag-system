# ==============================================================================
# NexusRAG Configuration Environment Variables
# ==============================================================================

# Application
PROJECT_NAME="NexusRAG — Agentic Knowledge Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL + pgvector)
# For local Docker setup:
DATABASE_URL="postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexusrag_db"
# Fallback local sqlite for quick standalone runs without Docker:
# DATABASE_URL="sqlite+aiosqlite:///./nexusrag.db"

# Redis Cache & Message Broker (Optional, falls back to in-memory if unreachable)
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Configuration
# Supported providers: "openai", "groq", "ollama", "mock" (for offline demo/testing)
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY="your-api-key-here"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embedding Model Configuration
# Supported providers: "sentence_transformers", "openai", "mock"
EMBEDDING_PROVIDER="sentence_transformers"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Reranker Configuration
# Supported: "cross_encoder", "heuristic"
RERANKER_TYPE="cross_encoder"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANK_TOP_K=5

# Retrieval Configuration
RETRIEVAL_TOP_K=10
RETRIEVAL_DENSE_WEIGHT=0.6
RETRIEVAL_SPARSE_WEIGHT=0.4
RRF_K=60
SIMILARITY_THRESHOLD=0.35

# Chunking Strategy Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=25

# Observability & Hallucination Guardrails
ENABLE_GROUNDING_CHECK=true
GROUNDING_THRESHOLD=0.70
LOG_LEVEL="INFO"

